2026-09-30T13:47:56.3727974Z ##[group]Run # errexit OFF: the runner's default `bash -e` kills this script at the
2026-09-30T13:47:56.3728669Z # errexit OFF: the runner's default `bash -e` kills this script at the
2026-09-30T13:47:56.3729197Z # intentional red `npm test` before TEST_EXIT=$? is captured; every
2026-09-30T13:47:56.3729715Z # failure path below already echoes ::error:: and exits 1 explicitly.
2026-09-30T13:47:56.3730127Z set +e; set -u
2026-09-30T13:47:56.3730445Z TEST_LOG="$(mktemp)"; trap 'rm -f "$TEST_LOG"' EXIT
2026-09-30T13:47:56.3730840Z BORDER_PACK_TEST=1 npm test > "$TEST_LOG" 2>&1
2026-09-30T13:47:56.3731172Z TEST_EXIT=$?
2026-09-30T13:47:56.3731417Z tail -n 20 "$TEST_LOG"
2026-09-30T13:47:56.3731822Z # Archive BEFORE the EXIT trap deletes $TEST_LOG, so the "Upload full test
2026-09-30T13:47:56.3732369Z # log" step ships the corpse regardless of which branch fails below. The
2026-09-30T13:47:56.3732941Z # copy is read-only forensics: every parse/diff still runs on "$TEST_LOG".
2026-09-30T13:47:56.3733438Z LOG_ARCHIVE="${RUNNER_TEMP:-/tmp}/border-test-log.txt"
2026-09-30T13:47:56.3733854Z cp "$TEST_LOG" "$LOG_ARCHIVE" 2>/dev/null || true
2026-09-30T13:47:56.3734294Z # h4 evidence: the runner's resource shape at gate time (cores, load,
2026-09-30T13:47:56.3734777Z # memory, disk, node/npm) — archived alongside the log below.
2026-09-30T13:47:56.3735570Z { date -u +"%FT%TZ"; nproc; cat /proc/loadavg; free -m | head -n 3; node -v; npm -v; df -h "$PWD" | tail -n 1; } > "${RUNNER_TEMP:-/tmp}/border-env-snapshot.txt" 2>/dev/null || true
2026-09-30T13:47:56.3736245Z 
2026-09-30T13:47:56.3736593Z SUM_TESTS="$(sed -n 's/^# tests \([0-9][0-9]*\)$/\1/p' "$TEST_LOG" | tail -n 1)"
2026-09-30T13:47:56.3737458Z SUM_PASS="$(sed -n 's/^# pass \([0-9][0-9]*\)$/\1/p' "$TEST_LOG" | tail -n 1)"
2026-09-30T13:47:56.3737987Z SUM_FAIL="$(sed -n 's/^# fail \([0-9][0-9]*\)$/\1/p' "$TEST_LOG" | tail -n 1)"
2026-09-30T13:47:56.3738510Z # node TAP's "# tests" total INCLUDES skipped tests but "# pass"/"# fail"
2026-09-30T13:47:56.3739030Z # exclude them, so the "# skipped N" count joins the balance equation
2026-09-30T13:47:56.3739542Z # below (line verified present in the tap reporter; absent ⇒ 0, never a
2026-09-30T13:47:56.3740065Z # parse failure — skips must not fake an unparsable-summary exit).
2026-09-30T13:47:56.3740619Z SUM_SKIPPED="$(sed -n 's/^# skipped \([0-9][0-9]*\)$/\1/p' "$TEST_LOG" | tail -n 1)"
2026-09-30T13:47:56.3741104Z [ -z "$SUM_SKIPPED" ] && SUM_SKIPPED=0
2026-09-30T13:47:56.3741514Z if [ -z "$SUM_TESTS" ] || [ -z "$SUM_PASS" ] || [ -z "$SUM_FAIL" ]; then
2026-09-30T13:47:56.3742286Z   echo "::error::could not parse TAP summary counts (# tests/# pass/# fail) — failing closed"
2026-09-30T13:47:56.3742760Z   exit 1
2026-09-30T13:47:56.3742979Z fi
