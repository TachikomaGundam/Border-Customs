2026-09-30T13:47:56.3748556Z # stage/freshness parity is a normalized CONTENT digest (gunzipped data.tar.gz
2026-09-30T13:47:56.3749151Z # canonicalized per entry + metadata minus rubygems_version/gem_version/date and
2026-09-30T13:47:56.3749719Z # the empty deprecated 3.4.x serializer keys), not the raw file sha256 whose
2026-09-30T13:47:56.3750271Z # per-environment determinism was the W3.1 flaky-green coin flip (root cause
2026-09-30T13:47:56.3750831Z # reproduced locally: RubyGems 3.4.20, the runner image's builder, stamps the
2026-09-30T13:47:56.3751378Z # build second into metadata date + gzip mtimes). All three are GREEN on the
2026-09-30T13:47:56.3751888Z # runner and the dev box (runner proof in the evidence file).
2026-09-30T13:47:56.3752418Z # v3 (W3.1, 2026-09-11) had retired the I1/AC1/AC3 verdaccio trio (colorette CI-ANSI
2026-09-30T13:47:56.3752994Z # counter blindness; NO_COLOR=1 + stripAnsi at source). The exact-set rule stays
2026-09-30T13:47:56.3753589Z # FULLY fail-closed — the only remaining entries are the two PLANNED border-push-
2026-09-30T13:47:56.3754165Z # channels C5 WIP reds. ANY other failure, ANY entry newly passing, or a counts
2026-09-30T13:47:56.3754599Z # mismatch still exits 1.
2026-09-30T13:47:56.3754914Z cat > /tmp/sanctioned.txt <<'SANCTIONED'
2026-09-30T13:47:56.3755358Z # PLANNED WIP red (border-push-channels C5) - retire when that scope lands
2026-09-30T13:47:56.3756184Z C5-1 subset discipline: a git-only PASS authorizes NO publish leg; a full PASS authorizes no crates-only push (fingerprint effectiveTargets scope binding)
2026-09-30T13:47:56.3757229Z # PLANNED WIP red (border-push-channels C5) - retire when that scope lands
2026-09-30T13:47:56.3758117Z C5-4 ordering: publish legs execute in descriptor order git→npm→pypi→crates→rubygems (exact spawn sequence), all five push-records under ONE key
2026-09-30T13:47:56.3758812Z SANCTIONED
2026-09-30T13:47:56.3759123Z sed -i -e 's/^[[:space:]]*//' -e '/^#/d' /tmp/sanctioned.txt
2026-09-30T13:47:56.3759482Z 
2026-09-30T13:47:56.3759849Z grep '^not ok ' "$TEST_LOG" | sed -E 's/^not ok [0-9]+ - //' | sort > /tmp/actual-failures.txt
2026-09-30T13:47:56.3760370Z sort /tmp/sanctioned.txt > /tmp/sanctioned.sorted.txt
2026-09-30T13:47:56.3760715Z 
2026-09-30T13:47:56.3761053Z if ! diff -u /tmp/sanctioned.sorted.txt /tmp/actual-failures.txt; then
2026-09-30T13:47:56.3761802Z   echo "::error::failing-test set is NOT exactly the sanctioned allowlist (diff above: - expected / + actual) — failing closed"
2026-09-30T13:47:56.3762699Z   # Dump each actual red's TAP YAML error block into the step log before
2026-09-30T13:47:56.3763220Z   # the trap deletes $TEST_LOG (W32 residual: I4 detail was unrecoverable).
2026-09-30T13:47:56.3763709Z   echo '::group::not-ok TAP detail (grep -A 25 "^not ok ")'
2026-09-30T13:47:56.3764105Z   grep -A 25 '^not ok ' "$TEST_LOG" || true
2026-09-30T13:47:56.3764423Z   echo '::endgroup'
2026-09-30T13:47:56.3764804Z   # Verdaccio server logs + fixture state survive under test/tmp — the
2026-09-30T13:47:56.3765333Z   # counter-flush race (h2) is only decidable from the server-side clock.
2026-09-30T13:47:56.3765894Z   tar -czf "${RUNNER_TEMP:-/tmp}/border-testtmp.tgz" test/tmp 2>/dev/null || true
2026-09-30T13:47:56.3766322Z   exit 1
2026-09-30T13:47:56.3766536Z fi
2026-09-30T13:47:56.3766740Z 
2026-09-30T13:47:56.3767387Z ACTUAL_N="$(grep -c . /tmp/actual-failures.txt || true)"
2026-09-30T13:47:56.3768008Z if [ "$SUM_FAIL" != "$ACTUAL_N" ] || [ "$((SUM_PASS + SUM_FAIL + SUM_SKIPPED))" != "$SUM_TESTS" ] || [ "$SUM_FAIL" -eq 0 ]; then
2026-09-30T13:47:56.3769014Z   echo "::error::TAP counts inconsistent (tests=${SUM_TESTS} pass=${SUM_PASS} fail=${SUM_FAIL} not-ok-lines=${ACTUAL_N}) — failing closed"
2026-09-30T13:47:56.3769725Z   echo '::group::not-ok TAP detail (grep -A 25 "^not ok ")'
2026-09-30T13:47:56.3770122Z   grep -A 25 '^not ok ' "$TEST_LOG" || true
2026-09-30T13:47:56.3770436Z   echo '::endgroup'
2026-09-30T13:47:56.3770682Z   exit 1
2026-09-30T13:47:56.3770891Z fi
2026-09-30T13:47:56.3771229Z # with a non-empty allowlist enforced above, a suite carrying exactly the
2026-09-30T13:47:56.3771783Z # sanctioned reds must exit 1; exit 0 would mean TAP and the runner disagree.
2026-09-30T13:47:56.3772216Z if [ "$TEST_EXIT" -ne 1 ]; then
2026-09-30T13:47:56.3772733Z   echo "::error::expected 'npm test' to exit 1 (sanctioned reds present); got ${TEST_EXIT} — failing closed"
2026-09-30T13:47:56.3773241Z   exit 1
2026-09-30T13:47:56.3773454Z fi
2026-09-30T13:47:56.3773823Z rm -f /tmp/sanctioned.txt /tmp/actual-failures.txt /tmp/sanctioned.sorted.txt
2026-09-30T13:47:56.3774561Z echo "release gate green: ${SUM_TESTS} tests / ${SUM_PASS} pass / exactly ${SUM_FAIL} sanctioned failure(s) matching the allowlist"
