{
  "name": "border-customs",
  "version": "0.4.1",
  "//": "publint is a runtime dep (exact pin): the npm-stage engine is invoked via bin resolution against the installed layout, so consumers get the publint-fail leg out of the box; the dev suite resolves the same node_modules/.bin/publint — no devDependencies entry is needed for it to stay green.",
  "description": "Fail-closed git push gate: secret scanning + supply-chain checks before any remote leaves the machine",
  "type": "module",
  "bin": {
    "border": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TachikomaGundam/Border-Customs.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --banner:js='import{createRequire as __borderRequire}from\"node:module\";const require=__borderRequire(import.meta.url);' --outfile=dist/index.js && node tools/copy-assets.mjs",
    "pretest": "node -e \"const fs=require('node:fs');fs.rmSync('test/tmp',{recursive:true,force:true});fs.mkdirSync('test/tmp',{recursive:true})\"",
    "test": "node --import ./tools/register-ts.mjs --test --test-reporter=tap test/*.test.ts"
  },
  "dependencies": {
    "@secretlint/core": "13.0.5",
    "@secretlint/secretlint-rule-no-dotenv": "13.0.5",
    "@secretlint/secretlint-rule-no-homedir": "13.0.5",
    "@secretlint/secretlint-rule-pattern": "13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "publint": "0.3.24",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.25.12",
    "secretlint": "13.0.5",
    "typescript": "5.9.3",
    "verdaccio": "6.10.2"
  }
}
